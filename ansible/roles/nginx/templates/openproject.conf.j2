server {
    listen 80;
    server_name 192.168.56.10;

    # Redirecionar todo o tráfego HTTP para HTTPS (RGPD - Cifragem em Trânsito)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name 192.168.56.10;

    # Certificados SSL/TLS auto-assinados
    ssl_certificate /etc/ssl/certs/techsolutions.crt;
    ssl_certificate_key /etc/ssl/private/techsolutions.key;

    # Protocolos e cifras seguras
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Tamanho máximo de upload de anexos no OpenProject
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Cabeçalhos obrigatórios para o OpenProject atrás de Reverse Proxy SSL
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;

        proxy_redirect off;
        proxy_read_timeout 90s;
    }
}