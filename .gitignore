# Diretória interna do Vagrant (contém chaves privadas SSH e IDs das VMs)
.vagrant/

# Ficheiros de log e discos virtuais
*.log
*.vdi
*.vmdk
*.ova
*.ovf

# Ficheiros de segredos e variáveis locais
*.pem
*.key
.env
.vault_pass
ansible/group_vars/all/vault.yml

# Ficheiros temporários do Ansible
*.retry
